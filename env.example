# ════════════════════════════════════════════════════════════
#  Настройки для локального запуска
#  Скопируй в .env и заполни своими данными
#  Файл .env НИКОГДА не попадёт на GitHub (он в .gitignore)
# ════════════════════════════════════════════════════════════

# ── Yandex Object Storage (S3) — РЕКОМЕНДУЕТСЯ ──────────────────
#
# Даёт ПОСТОЯННЫЕ прямые ссылки вида:
#   https://storage.yandexcloud.net/БАКЕТ/VLESS_WORKING.txt
# Отдаёт сырой текст напрямую — Karing читает без проблем.
#
# Настройка (10 минут):
#   1. https://cloud.yandex.ru → регистрация (есть бесплатный грант)
#   2. Object Storage → "Создать бакет"
#      - Имя: уникальное, например vless-collector-12345
#      - Доступ на чтение объектов: ПУБЛИЧНОЕ
#   3. Сервисные аккаунты → "Создать сервисный аккаунт"
#      - Роль: storage.editor
#   4. Открой аккаунт → "Ключи доступа" → "Создать статический ключ"
#      → скопируй Key ID и Secret Key (Secret — один раз!)
#
YANDEX_S3_BUCKET=vless-collector-12345
YANDEX_S3_ACCESS_KEY=твой_key_id
YANDEX_S3_SECRET_KEY=твой_secret_key

# ── Яндекс Диск (запасной вариант, без гарантии прямых ссылок) ──
# OAuth-токен: https://oauth.yandex.ru/
YANDEX_TOKEN=

# WebDAV: пароль приложения — https://id.yandex.ru/security/app-passwords
YANDEX_LOGIN=
YANDEX_PASS=

# ── Telegram-уведомления (необязательно) ─────────────────────
# Токен бота: @BotFather → /newbot
# Chat ID: @userinfobot → /start
TG_BOT_TOKEN=1234567890:AAF_токен
TG_CHAT_ID=123456789

# ── Тонкая настройка ─────────────────────────────────────────
MAX_WORKERS=150
MAX_LATENCY=4000
MAX_CONFIGS=500
RELIABILITY_MIN=0.4
HISTORY_PRUNE_DAYS=7
